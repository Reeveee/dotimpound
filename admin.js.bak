const $=id=>document.getElementById(id);let me=null,tab='vehicles',records=[],payments=[],members=[],tows=[];const isAdmin=()=>me?.role==='admin';
async function init(){const {data:{session}}=await sb.auth.getSession();if(!session){location.replace('login.html');return}const {data:staff,error}=await sb.from('dot_staff').select('*').eq('id',session.user.id).single();if(error||!staff?.enabled){await sb.auth.signOut();location.replace('login.html');return}me=staff;await refresh()}
async function logout(){await sb.auth.signOut();location.replace('login.html')}
async function refresh(){const [r,p,m,t]=await Promise.all([sb.from('impounds').select('*').order('created_at',{ascending:false}),sb.from('payments').select('*').order('paid_at',{ascending:false}),isAdmin()?sb.from('dot_staff').select('*').order('created_at',{ascending:true}):Promise.resolve({data:[]}),sb.from('tow_requests').select('*').order('created_at',{ascending:false})]);records=r.data||[];payments=p.data||[];members=m.data||[];tows=t.data||[];render()}
function switchTab(t){if(t==='members'&&!isAdmin())return;tab=t;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.tab===t));$('vehiclePanel').classList.toggle('hidden',t!=='vehicles');$('towPanel').classList.toggle('hidden',t!=='tows');$('paymentPanel').classList.toggle('hidden',t!=='payments');$('memberPanel').classList.toggle('hidden',t!=='members');render()}
function openModal(){$('modal').classList.remove('hidden');$('plateA').focus()}function closeModal(){$('modal').classList.add('hidden')}
function openMemberModal(){if(!isAdmin())return;$('memberModal').classList.remove('hidden');$('userA').focus()}function closeMemberModal(){$('memberModal').classList.add('hidden')}
async function addImpound(){let p=$('plateA').value.trim().toUpperCase();if(!p)return;const row={registration:p,vehicle:$('vehicleA').value.trim()||'Vehicle on file',colour:$('colourA').value.trim()||'Not recorded',reason:$('reasonA').value,impound_lot:$('lotA').value,impounded_by:$('officerA').value.trim()||me.username,fee:Number($('feeA').value)||495,status:'UNPAID'};const {error}=await sb.from('impounds').insert(row);if(error){alert('Could not create impound: '+error.message);return}['plateA','vehicleA','colourA'].forEach(x=>$(x).value='');closeModal();await refresh()}
async function releaseVehicle(id){let r=records.find(x=>x.id===id);if(!r)return;if(r.status!=='PAID'&&!confirm('This vehicle is not marked PAID. Release anyway?'))return;const {error}=await sb.from('impounds').update({status:'RELEASED',released_at:new Date().toISOString()}).eq('id',id);if(error)return alert(error.message);await refresh()}
async function removeVehicle(id){if(!isAdmin())return alert('Only DOT admins can delete impound records.');if(!confirm('Delete this impound record?'))return;const {error}=await sb.from('impounds').delete().eq('id',id);if(error)return alert('Delete failed: '+error.message);await refresh()}
async function addMember(){if(!isAdmin())return;const username=$('userA').value.trim().toLowerCase(),password=$('passA').value,role=$('adminA').checked?'admin':'operator';if(!username||!password){$('memberError').textContent='Username and password are required.';return}const {data:{session}}=await sb.auth.getSession();const res=await fetch('/.netlify/functions/manage-staff',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+session.access_token},body:JSON.stringify({action:'create',username,password,role})});const out=await res.json();if(!res.ok){$('memberError').textContent=out.error||'Could not create account.';return}$('userA').value='';$('passA').value='';$('adminA').checked=false;$('memberError').textContent='';closeMemberModal();await refresh()}
async function toggleMember(id){if(!isAdmin()||id===me.id)return;const u=members.find(x=>x.id===id);const {error}=await sb.from('dot_staff').update({enabled:!u.enabled}).eq('id',id);if(error)return alert(error.message);await refresh()}
async function deleteMember(id){if(!isAdmin()||id===me.id)return;const u=members.find(x=>x.id===id);if(!confirm('Delete DOT account '+u.username+'?'))return;const {data:{session}}=await sb.auth.getSession();const res=await fetch('/.netlify/functions/manage-staff',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+session.access_token},body:JSON.stringify({action:'delete',user_id:id})});const out=await res.json();if(!res.ok)return alert(out.error||'Delete failed.');await refresh()}
async function towStatus(id,status){const row=tows.find(x=>x.id===id);if(!row)return;const patch={status};if(status==='CLAIMED'&&!row.claimed_by)patch.claimed_by=me.username;if(status==='COMPLETE')patch.completed_at=new Date().toISOString();const {error}=await sb.from('tow_requests').update(patch).eq('id',id);if(error)return alert(error.message);await refresh()}
async function impoundTow(id){const t=tows.find(x=>x.id===id);if(!t)return;if(!confirm('Complete this tow and create an active impound for '+t.registration+'?'))return;const imp={registration:t.registration,vehicle:t.vehicle||'Vehicle on file',colour:t.colour||'Not recorded',reason:t.reason||'Police Impound',impound_lot:t.destination==='Nearest DOT Impound'?'Sandy Shores Impound':t.destination,impounded_by:me.username,fee:495,status:'UNPAID'};const {error}=await sb.from('impounds').insert(imp);if(error)return alert('Could not create impound: '+error.message);await sb.from('tow_requests').update({status:'IMPOUNDED',claimed_by:t.claimed_by||me.username,completed_at:new Date().toISOString()}).eq('id',id);await refresh()}
function render(){if(!me)return;$('who').textContent=me.username;$('whoRole').textContent=me.role.toUpperCase();$('whoRole').className='rolepill '+me.role;$('membersTab').classList.toggle('hidden',!isAdmin());$('activeCount').textContent=records.filter(x=>x.status!=='RELEASED').length;$('paidCount').textContent=payments.length;$('collected').textContent='$'+payments.reduce((s,x)=>s+Number(x.amount),0).toFixed(2);let q=($('search')?.value||'').toUpperCase();$('vehicleRows').innerHTML=records.filter(x=>!q||x.registration.includes(q)||(x.vehicle||'').toUpperCase().includes(q)).map(r=>`<tr><td><b>${r.registration}</b><small>${r.vehicle}</small></td><td>${r.reason||'—'}</td><td>${r.impound_lot||'—'}</td><td>$${Number(r.fee).toFixed(2)}</td><td><span class="badge ${r.status.toLowerCase()}">${r.status}</span></td><td>${new Date(r.created_at).toLocaleString('en-GB')}<small>By ${r.impounded_by||'DOT'}</small></td><td><button class="mini" onclick="releaseVehicle(${r.id})">RELEASE</button>${isAdmin()?`<button class="mini ghost" onclick="removeVehicle(${r.id})">×</button>`:''}</td></tr>`).join('')||'<tr><td colspan="7" class="empty">No impound records yet. Click + NEW IMPOUND to create one.</td></tr>';$('towBadge').textContent=tows.filter(x=>!['COMPLETE','IMPOUNDED','CANCELLED'].includes(x.status)).length;$('towRows').innerHTML=tows.filter(x=>!q||x.registration.includes(q)||(x.vehicle||'').toUpperCase().includes(q)||(x.location||'').toUpperCase().includes(q)).map(t=>`<tr><td><b>${t.reference||('TR-'+String(t.id).padStart(4,'0'))}</b><small>${new Date(t.created_at).toLocaleString('en-GB')}</small></td><td><b>${t.registration}</b><small>${t.colour||'—'} ${t.vehicle||''}</small></td><td>${t.location||'—'}<small>${t.destination||''}</small></td><td>${t.agency||'—'}<small>${t.requesting_officer||'—'}</small></td><td><span class="priority ${String(t.priority||'ROUTINE').toLowerCase()}">${t.priority||'ROUTINE'}</span></td><td><span class="badge tow-${String(t.status).toLowerCase()}">${t.status}</span>${t.claimed_by?`<small>DOT: ${t.claimed_by}</small>`:''}</td><td><div class="tow-actions">${t.status==='PENDING'?`<button class="mini" onclick="towStatus(${t.id},'CLAIMED')">CLAIM</button>`:''}${t.status==='CLAIMED'?`<button class="mini" onclick="towStatus(${t.id},'EN ROUTE')">EN ROUTE</button>`:''}${t.status==='EN ROUTE'?`<button class="mini" onclick="towStatus(${t.id},'ON SCENE')">ON SCENE</button>`:''}${t.status==='ON SCENE'?`<button class="mini" onclick="impoundTow(${t.id})">IMPOUND</button><button class="mini ghost" onclick="towStatus(${t.id},'COMPLETE')">NO IMPOUND</button>`:''}</div></td></tr>`).join('')||'<tr><td colspan="7" class="empty">No police tow requests.</td></tr>';$('paymentRows').innerHTML=payments.filter(x=>!q||x.registration.includes(q)).map(p=>`<tr><td>${new Date(p.paid_at).toLocaleString('en-GB')}</td><td><b>${p.registration}</b></td><td>$${Number(p.amount).toFixed(2)}</td><td><span class="badge paid">PAID</span></td><td>${p.reference}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">No payments recorded yet.</td></tr>';if(isAdmin())$('memberRows').innerHTML=members.map(u=>`<tr><td><b>${u.username}</b></td><td><span class="rolepill ${u.role}">${u.role.toUpperCase()}</span></td><td>${u.enabled?'ACTIVE':'DISABLED'}</td><td>${new Date(u.created_at).toLocaleString('en-GB')}</td><td>${u.id===me.id?'<span class="micro">CURRENT USER</span>':`<button class="mini" onclick="toggleMember('${u.id}')">${u.enabled?'DISABLE':'ENABLE'}</button><button class="mini ghost" onclick="deleteMember('${u.id}')">×</button>`}</td></tr>`).join('')}
init();
