<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>San Andreas DOT | Operations</title><link rel="stylesheet" href="style.css"></head><body class="adminbody"><header><div class="brand"><div class="seal">SA</div><div><b>SAN ANDREAS</b><span>DEPARTMENT OF TRANSPORTATION</span></div></div><nav><a href="index.html">PUBLIC PORTAL</a><a href="sop.html">SOPs</a><div class="staffbox"><span><b id="who"></b> <span id="whoRole" class="rolepill"></span></span><button class="logout" onclick="logout()">LOG OUT</button></div></nav></header><main class="admin"><div class="adminhead"><div><div class="eyebrow">STAFF CONSOLE</div><h2>IMPOUND CONTROL</h2><p>Operators can create impounds, monitor payments and release vehicles. Admins can also manage DOT staff accounts and delete records.</p></div><button class="gold compact" onclick="openModal()">+ NEW IMPOUND</button></div><div class="stats"><div class="stat"><small>ACTIVE IMPOUNDS</small><b id="activeCount">0</b></div><div class="stat"><small>PAYMENTS</small><b id="paidCount">0</b></div><div class="stat"><small>COLLECTED</small><b id="collected">$0.00</b></div></div><div class="tabs"><button class="tab active" data-tab="vehicles" onclick="switchTab('vehicles')">IMPOUNDED VEHICLES</button><button class="tab" data-tab="tows" onclick="switchTab('tows')">TOW REQUESTS <span id="towBadge" class="tabcount">0</span></button><button class="tab" data-tab="payments" onclick="switchTab('payments')">PAYMENT RECORDS</button><button id="membersTab" class="tab" data-tab="members" onclick="switchTab('members')">DOT MEMBERS</button></div><div class="adminbar"><input id="search" placeholder="Search plate or vehicle..." oninput="render()"></div><section id="vehiclePanel"><div class="tablewrap"><table><thead><tr><th>VEHICLE</th><th>REASON</th><th>LOT</th><th>FEE</th><th>STATUS</th><th>IMPOUNDED</th><th>ACTION</th></tr></thead><tbody id="vehicleRows"></tbody></table></div></section><section id="towPanel" class="hidden"><div class="tablewrap"><table><thead><tr><th>REQUEST</th><th>VEHICLE</th><th>LOCATION</th><th>REQUESTED BY</th><th>PRIORITY</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody id="towRows"></tbody></table></div></section><section id="paymentPanel" class="hidden"><div class="tablewrap"><table><thead><tr><th>DATE & TIME</th><th>REGISTRATION</th><th>AMOUNT</th><th>STATUS</th><th>REFERENCE</th></tr></thead><tbody id="paymentRows"></tbody></table></div></section><section id="memberPanel" class="hidden"><div class="adminhead"><div><h3>DOT MEMBERS</h3><p>Accounts are created by DOT administrators. Choose Admin only for members who should manage other staff.</p></div><button class="gold compact" onclick="openMemberModal()">+ REGISTER DOT MEMBER</button></div><div class="tablewrap"><table><thead><tr><th>USERNAME</th><th>PRIVILEGE</th><th>STATUS</th><th>CREATED</th><th>ACTION</th></tr></thead><tbody id="memberRows"></tbody></table></div></section></main>
<div id="modal" class="modal hidden"><div class="modalcard"><button class="modalx" onclick="closeModal()">×</button><div class="eyebrow">DOT OPERATIONS</div><h2>CREATE IMPOUND</h2><div class="formgrid"><label>REGISTRATION<input id="plateA" placeholder="SCAT"></label><label>VEHICLE<input id="vehicleA" placeholder="Bravado Buffalo S"></label><label>COLOUR<input id="colourA" placeholder="Red"></label><label>RELEASE FEE<input id="feeA" type="number" value="495"></label><label>REASON<select id="reasonA"><option>Illegal Parking</option><option>Police Impound</option><option>Abandoned Vehicle</option><option>Unsafe Vehicle</option><option>Traffic Offence</option><option>Other</option></select></label><label>IMPOUND LOT<select id="lotA"><option>Sandy Shores Impound</option><option>Los Santos Impound</option><option>Paleto Bay Impound</option></select></label><label class="wide">IMPOUNDED BY<input id="officerA" placeholder="Leave blank to use your DOT username"></label></div><button class="gold" onclick="addImpound()">CREATE ACTIVE IMPOUND →</button></div></div>
<div id="memberModal" class="modal hidden"><div class="modalcard"><button class="modalx" onclick="closeMemberModal()">×</button><div class="eyebrow">ADMINISTRATION</div><h2>REGISTER DOT MEMBER</h2><div class="formgrid"><label>USERNAME<input id="userA" placeholder="dot22" autocomplete="off"></label><label>PASSWORD<input id="passA" type="password" placeholder="Create a password" autocomplete="new-password"></label><label class="wide toggleline"><input id="adminA" type="checkbox"><span><b>ADMIN PRIVILEGES</b><small>Unchecked accounts are Operators. Admins can create/manage DOT members and delete records.</small></span></label></div><div id="memberError" class="error"></div><button class="gold" onclick="addMember()">CREATE DOT ACCOUNT →</button></div></div><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><script src="config.js"></script><script src="admin.js"></script></body></html>
